# AWS Region to deploy the beacon into
aws_region = "ap-southeast-2"

# Prefix for resource names
project_name = "cf-china-beacon"

# Cheapest Graviton2 instance (~$3.80 USD/month on-demand)
instance_type = "t4g.nano"

# Public IPv4 CIDRs of your China Office(s) to EXCLUDE.
# Connections from these IPs on TCP 443 are rejected with TCP RST so office users
# do not match the China roaming profile.
china_office_cidrs = [
  # "203.0.113.10/32",
]

# Optional: Your admin workstation IPv4 CIDR(s) outside China so you can test
# the HTTPS endpoint directly with curl or openssl.
allowed_test_cidrs = [
  # "198.51.100.25/32",
]
